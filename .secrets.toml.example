# ──────────────────────────────────────────────────────────────────────────────
# .secrets.toml.example — copy to .secrets.toml and fill in secrets
# NEVER commit .secrets.toml — it is in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

[default]
scm_client_secret = "your-default-client-secret"

# Per-tenant secrets (mirrors the [tenants.*] blocks in settings.toml)
# [tenants.customer-a]
# client_secret = "customer-a-secret"
#
# [tenants.customer-b]
# client_secret = "customer-b-secret"

# REST tool gateway keys (/v1) — store hashes only. Mint one with:
#   uv run python -m scm_harbourmaster_mcp.gateway.keys new \
#       --id noc-deepseek --tenants customer-a --toolsets noc --llm-provider deepseek
# which prints the key once and the block to paste here:
# [gateway_keys.noc-deepseek]
# key_sha256 = "<sha256 of the key>"
# access = "read"                 # read | write (write also needs SCM_MCP_HTTP_REST_WRITE=1)
# tenants = ["customer-a"]        # TSG IDs, settings keys or labels; ["*"] = every tenant
# toolsets = ["noc"]              # toolsets / profiles this key may use
# rate_per_minute = 60            # optional
# llm_provider = "deepseek"       # optional; checked against allowed_llm_providers
